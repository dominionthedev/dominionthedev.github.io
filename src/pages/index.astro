---
import Layout from "../layouts/Layout.astro";
import WaypointNav from "../components/WaypointNav.astro";
import Terminal from "../components/Terminal.astro";
import RouteMeter from "../components/RouteMeter.astro";
import BootOverlay from "../components/BootOverlay.astro";

const waypoints = [
  { id: "hero", label: "start" },
  { id: "philosophy", label: "philosophy" },
  { id: "terminal", label: "how i work" },
  { id: "work", label: "work" },
  { id: "connect", label: "connect" },
];

type Tier = "shipped" | "in-progress" | "experimental";

interface Project {
  name: string;
  desc: string;
  meta: string;
  url: string;
  tier: Tier;
}

const projects: Project[] = [
  {
    name: "RunBox",
    desc: "Environment isolation and reproducibility for macOS. No containers, no VMs, no Nix.",
    meta: "Go · 3★",
    url: "https://github.com/dominionthedev/runbox",
    tier: "shipped",
  },
  {
    name: "Finite",
    desc: "Programmable SVG engine — fluent API for shapes, gradients, filters, validation.",
    meta: "Go · 3★",
    url: "https://github.com/dominionthedev/finite",
    tier: "shipped",
  },
  {
    name: "Loom",
    desc: "AI workflow runtime. The Lua file is the workflow — no wrapper, no config layer.",
    meta: "Go · 1★",
    url: "https://github.com/dominionthedev/loom",
    tier: "shipped",
  },
  {
    name: "lean",
    desc: "A lightweight, expressive environment profile manager for .env files.",
    meta: "Go",
    url: "https://github.com/dominionthedev/lean",
    tier: "shipped",
  },
  {
    name: "alfig",
    desc: "Unified config library — TOML, JSON, YAML, and CONF interchangeably, one schema.",
    meta: "Python · PyPI · 3★",
    url: "https://github.com/dominionthedev/alfig",
    tier: "shipped",
  },
  {
    name: "OllaCloud",
    desc: "Use Ollama Cloud without downloading Ollama.",
    meta: "Go",
    url: "https://github.com/dominionthedev/ollacloud",
    tier: "shipped",
  },
  {
    name: "neobar",
    desc: "A VSCode-style activity bar for Neovim. 3 of 7 planned adapters live.",
    meta: "Lua",
    url: "https://github.com/dominionthedev/neobar",
    tier: "in-progress",
  },
  {
    name: "Leraniode",
    desc: "The company I own. Illygen (intelligence) and Wondertone (beauty) — two pillars, one discipline.",
    meta: "org · owner",
    url: "https://github.com/leraniode",
    tier: "in-progress",
  },
  {
    name: "sheme",
    desc: "Turns Wondertone palettes into real shell themes — OSC sequences, bash/zsh compatible.",
    meta: "Go · experimental",
    url: "https://github.com/dominionthedev/exp",
    tier: "experimental",
  },
  {
    name: "sensible",
    desc: "Simple, smart logic and types for data modeling and workflows, in Python and Go.",
    meta: "Python / Go · experimental",
    url: "https://github.com/dominionthedev/exp",
    tier: "experimental",
  },
];

const tiers: { key: Tier; label: string }[] = [
  { key: "shipped", label: "shipped" },
  { key: "in-progress", label: "in progress" },
  { key: "experimental", label: "experimental" },
];
---

<Layout>
  <BootOverlay />
  <RouteMeter />
  <WaypointNav waypoints={waypoints} />

  <script>
    function revealHero() {
      const el = document.querySelector<HTMLElement>("[data-typewriter]");
      if (!el) return;
      el.textContent = el.dataset.text ?? "";
      el.closest(".hero-thesis")?.classList.add("is-visible");
    }

    // The boot overlay may resolve synchronously (repeat session, reduced
    // motion) before this script's listener attaches — check its actual
    // resolved state directly instead of trusting the event alone.
    const overlay = document.querySelector<HTMLElement>("[data-boot-overlay]");
    if (overlay?.dataset.hidden === "true") {
      revealHero();
    } else {
      window.addEventListener("dd:boot-complete", revealHero, { once: true });
    }
  </script>

  <main class="tour">
    <section id="hero" data-section="hero" class="section section--hero">
      <span class="section-watermark" aria-hidden="true">00</span>
      <p class="label reveal">dominiondev</p>
      <h1 class="hero-thesis">
        <span data-typewriter data-text="I live in the terminal"></span><span
          class="hero-cursor"
          aria-hidden="true">_</span
        >
      </h1>
      <p class="hero-sub reveal">A tour, not a resume.</p>
    </section>

    <span class="section-divider" aria-hidden="true">┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈</span>

    <section id="philosophy" data-section="philosophy" class="section">
      <span class="section-watermark" aria-hidden="true">01</span>
      <p class="label reveal">01 — philosophy</p>
      <h2 class="reveal">How I think.</h2>
      <div class="philosophy-list">
        <p class="philosophy-line reveal">
          <span class="prompt">&gt;</span> Stylishness isn't something you look at. It's how
          I say exactly what I feel.
        </p>
        <p class="philosophy-line reveal">
          <span class="prompt">&gt;</span> A limit is not a stop. It's a challenge.
        </p>
        <p class="philosophy-proof reveal">
          RunBox exists because a 4GB MacBook Air on macOS 11 couldn't run Docker. So
          instead of waiting for better hardware, I built around the limit.
        </p>
      </div>
    </section>

    <span class="section-divider" aria-hidden="true">┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈</span>

    <section id="terminal" data-section="terminal" class="section">
      <span class="section-watermark" aria-hidden="true">02</span>
      <p class="label reveal">02 — how i work</p>
      <h2 class="reveal">Walk through it yourself.</h2>
      <div class="reveal">
        <Terminal />
      </div>
    </section>

    <span class="section-divider" aria-hidden="true">┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈</span>

    <section id="work" data-section="work" class="section section--work">
      <span class="section-watermark" aria-hidden="true">03</span>
      <p class="label reveal">03 — work</p>
      <h2 class="reveal">What I've built and what's in progress.</h2>

      {
        tiers.map((tier) => (
          <div class="work-tier">
            <p class="work-tier-label reveal">
              <span class={`tier-dot tier-dot--${tier.key}`} /> {tier.label}
            </p>
            <div class="work-list">
              {projects
                .filter((p) => p.tier === tier.key)
                .map((p) => (
                  <a
                    href={p.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={`work-row reveal work-row--${tier.key} link-underline`}
                  >
                    <span class="work-name">{p.name}</span>
                    <span class="work-desc">{p.desc}</span>
                    <span class="work-meta">{p.meta}</span>
                  </a>
                ))}
            </div>
          </div>
        ))
      }
    </section>

    <span class="section-divider" aria-hidden="true">┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈</span>

    <section id="connect" data-section="connect" class="section">
      <span class="section-watermark" aria-hidden="true">04</span>
      <p class="label reveal">04 — connect</p>
      <h2 class="reveal">How to reach me.</h2>
      <div class="connect-list">
        <a
          href="https://github.com/dominionthedev"
          target="_blank"
          rel="noopener noreferrer"
          class="connect-line reveal link-underline"
        >
          <span class="prompt">&gt;</span> github.com/dominionthedev
          <span class="connect-note">— the real door.</span>
        </a>
        <a
          href="mailto:dominionthedeveloper@gmail.com"
          class="connect-line reveal link-underline"
        >
          <span class="prompt">&gt;</span> dominionthedeveloper@gmail.com
        </a>
        <a
          href="https://twitter.com/dominionthedev"
          target="_blank"
          rel="noopener noreferrer"
          class="connect-line reveal link-underline"
        >
          <span class="prompt">&gt;</span> x.com/dominionthedev
        </a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .tour {
    max-width: 720px;
    margin: 0 auto;
    padding-left: calc(var(--space-24) + 12px);
  }

  .section {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-4);
    padding: var(--space-16) var(--space-6);
    overflow: hidden;
  }

  .section-watermark {
    position: absolute;
    top: -0.15em;
    right: var(--space-4);
    font-family: var(--font-mono);
    font-size: 13rem;
    font-weight: 700;
    line-height: 1;
    color: oklch(94% 0.02 295 / 0.04);
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .section > *:not(.section-watermark) {
    position: relative;
    z-index: 1;
  }

  .section-divider {
    display: block;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    color: oklch(55% 0.02 295 / 0.25);
    padding: var(--space-4) 0;
    max-width: 720px;
    margin: 0 auto;
    overflow: hidden;
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .section-watermark {
      font-size: 7rem;
    }
  }

  .section--hero {
    gap: var(--space-3);
  }

  .section--work {
    min-height: auto;
    justify-content: flex-start;
    padding-top: var(--space-24);
    padding-bottom: var(--space-24);
  }

  .work-tier {
    margin-top: var(--space-8);
  }

  .work-tier-label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-static);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .tier-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    display: inline-block;
  }
  .tier-dot--shipped { background: var(--color-phosphor); }
  .tier-dot--in-progress { background: var(--color-pulse); }
  .tier-dot--experimental { background: var(--color-static); }

  .work-list {
    display: flex;
    flex-direction: column;
  }

  .work-row {
    display: grid;
    grid-template-columns: 9rem 1fr auto;
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-3) var(--space-3);
    border-left: 2px solid transparent;
    transform: translateX(0);
    transition: border-color var(--duration-base) var(--ease-smooth),
      background var(--duration-base) var(--ease-smooth),
      transform var(--duration-base) var(--ease-smooth),
      box-shadow var(--duration-base) var(--ease-smooth);
  }

  .work-row:hover {
    background: oklch(20% 0.035 295 / 0.6);
    transform: translateX(6px);
  }

  .work-row--shipped:hover {
    border-left-color: var(--color-phosphor);
    box-shadow: -6px 0 16px -8px oklch(85% 0.22 155 / 0.4);
  }
  .work-row--in-progress:hover {
    border-left-color: var(--color-pulse);
    box-shadow: -6px 0 16px -8px oklch(65% 0.25 350 / 0.4);
  }
  .work-row--experimental:hover {
    border-left-color: var(--color-static);
    box-shadow: -6px 0 16px -8px oklch(55% 0.02 295 / 0.3);
  }

  .work-name {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--color-signal);
  }

  .work-desc {
    font-size: 0.95rem;
    color: var(--color-static);
    line-height: 1.5;
  }

  .work-meta {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--color-static);
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .work-row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }

  .connect-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .connect-line {
    display: block;
    width: fit-content;
    font-family: var(--font-mono);
    font-size: var(--text-header);
  }

  .connect-line .prompt {
    color: var(--color-phosphor);
    margin-right: var(--space-2);
  }

  .connect-note {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    color: var(--color-static);
    margin-left: var(--space-2);
  }

  .connect-list .reveal:nth-child(1) { transition-delay: 0ms; }
  .connect-list .reveal:nth-child(2) { transition-delay: 80ms; }
  .connect-list .reveal:nth-child(3) { transition-delay: 160ms; }

  .hero-thesis {
    display: inline-flex;
    align-items: baseline;
    opacity: 0;
    transition: opacity 500ms var(--ease-smooth);
  }

  .hero-thesis.is-visible {
    opacity: 1;
  }

  .hero-cursor {
    color: var(--color-phosphor);
    font-family: var(--font-mono);
    font-weight: 600;
    animation: blink 1.1s step-end infinite;
    margin-left: 2px;
  }

  .hero-sub {
    font-family: var(--font-mono);
    font-size: var(--text-terminal);
    color: var(--color-static);
    transition-delay: var(--duration-slow);
  }

  .philosophy-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .philosophy-line {
    font-size: var(--text-header);
    line-height: 1.4;
  }

  .philosophy-line .prompt {
    font-family: var(--font-mono);
    color: var(--color-phosphor);
    margin-right: var(--space-2);
  }

  .philosophy-proof {
    font-family: var(--font-mono);
    font-size: var(--text-terminal);
    color: var(--color-static);
    line-height: var(--leading-terminal);
    padding-left: calc(var(--space-2) + 1ch);
    border-left: 1px solid oklch(55% 0.02 295 / 0.3);
    margin-top: var(--space-2);
  }

  .philosophy-list .reveal:nth-child(1) { transition-delay: 0ms; }
  .philosophy-list .reveal:nth-child(2) { transition-delay: 80ms; }
  .philosophy-list .reveal:nth-child(3) { transition-delay: 160ms; }

  @keyframes blink {
    0%, 45% { opacity: 1; }
    50%, 95% { opacity: 0; }
    100% { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-cursor {
      animation: none;
      opacity: 1;
    }
  }

  @media (max-width: 768px) {
    .tour {
      padding-left: calc(var(--space-12) + 4px);
    }
  }
</style>
