---
---

<div class="route-meter" aria-hidden="true">
  <pre class="route-glyphs" data-route-empty>{Array(60).fill("░").join("\n")}</pre>
  <pre class="route-glyphs route-glyphs--fill" data-route-fill>{Array(60).fill("▓").join("\n")}</pre>
</div>

<style>
  .route-meter {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    width: 28px;
    overflow: hidden;
    z-index: 50;
    pointer-events: none;
  }

  .route-glyphs {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 15px;
    line-height: 1.72vh;
    color: oklch(55% 0.02 295 / 0.35);
    text-align: center;
    width: 100%;
    white-space: pre;
  }

  .route-glyphs--fill {
    position: absolute;
    top: 0;
    left: 0;
    color: var(--color-phosphor);
    text-shadow: 0 0 12px oklch(85% 0.22 155 / 0.55);
    clip-path: inset(100% 0 0 0);
    will-change: clip-path;
  }

  @media (max-width: 768px) {
    .route-meter {
      width: 16px;
    }
    .route-glyphs {
      font-size: 10px;
    }
  }
</style>

<script>
  function initRouteMeter() {
    const fill = document.querySelector<HTMLElement>("[data-route-fill]");
    if (!fill) return;

    function update() {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? Math.min(1, Math.max(0, scrollTop / docHeight)) : 0;
      fill!.style.clipPath = `inset(${(1 - progress) * 100}% 0 0 0)`;
    }

    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    update();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initRouteMeter);
  } else {
    initRouteMeter();
  }
</script>
