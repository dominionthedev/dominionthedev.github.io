<section id="connect" data-section="connect" class="section">
  <span class="section-watermark" data-watermark="04" aria-hidden="true">04</span>
  <p class="label reveal">04 — connect</p>
  <h2 class="reveal">How to reach me.</h2>
  <div class="connect-list">
    <a
      href="https://github.com/dominionthedev"
      target="_blank"
      rel="noopener noreferrer"
      class="connect-line reveal link-underline"
    >
      <span class="prompt">&gt;</span> github.com/dominionthedev
      <span class="connect-note">— the real door.</span>
    </a>
    <a
      href="mailto:dominionthedeveloper@gmail.com"
      class="connect-line reveal link-underline"
    >
      <span class="prompt">&gt;</span> dominionthedeveloper@gmail.com
    </a>
    <a
      href="https://twitter.com/dominionthedev"
      target="_blank"
      rel="noopener noreferrer"
      class="connect-line reveal link-underline"
    >
      <span class="prompt">&gt;</span> x.com/dominionthedev
    </a>
  </div>
</section>

<style>
  .connect-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .connect-line {
    display: block;
    width: fit-content;
    max-width: 100%;
    overflow-wrap: anywhere;
    font-family: var(--font-recursive);
    font-variation-settings: var(--vf-terminal);
    font-size: var(--text-header);
  }

  .connect-line .prompt {
    color: var(--color-phosphor);
    margin-right: var(--space-2);
  }

  .connect-note {
    font-family: var(--font-recursive);
    font-variation-settings: var(--vf-body);
    font-size: var(--text-body);
    color: var(--color-static);
    margin-left: var(--space-2);
  }

  .connect-list .reveal:nth-child(1) { transition-delay: 0ms; }
  .connect-list .reveal:nth-child(2) { transition-delay: 80ms; }
  .connect-list .reveal:nth-child(3) { transition-delay: 160ms; }
</style>
