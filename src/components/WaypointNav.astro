---
interface Waypoint {
  id: string;
  label: string;
}

interface Props {
  waypoints: Waypoint[];
}

const { waypoints } = Astro.props;
---

<nav class="waypoint-nav" aria-label="Page sections">
  <ol class="waypoint-list">
    {
      waypoints.map((wp) => (
        <li class="waypoint-item">
          <a href={`#${wp.id}`} class="waypoint-link" data-waypoint-link={wp.id}>
            <span class="waypoint-dot" data-waypoint-dot={wp.id} />
            <span class="waypoint-label">{wp.label}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .waypoint-nav {
    position: fixed;
    left: 38px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 100;
  }

  .waypoint-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .waypoint-item {
    position: relative;
  }

  .waypoint-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-1) 0;
  }

  .waypoint-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--color-static);
    border: 1px solid var(--color-void);
    outline: 2px solid oklch(55% 0.02 295 / 0.3);
    outline-offset: 0;
    flex-shrink: 0;
    position: relative;
    transition: background var(--duration-base) var(--ease-smooth),
      outline-color var(--duration-base) var(--ease-smooth);
  }

  .waypoint-dot::before {
    content: "";
    position: absolute;
    right: 100%;
    top: 50%;
    width: 12px;
    height: 1px;
    background: oklch(55% 0.02 295 / 0.3);
    transform: translateY(-50%);
    transition: background var(--duration-base) var(--ease-smooth);
  }

  .waypoint-dot[data-active="true"]::before {
    background: var(--color-phosphor);
  }

  .waypoint-dot[data-active="true"] {
    background: var(--color-phosphor);
    outline-color: var(--color-phosphor);
    box-shadow: var(--glow-phosphor);
  }

  .waypoint-label {
    font-family: var(--font-recursive);
    font-variation-settings: var(--vf-label);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-static);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--duration-fast) var(--ease-smooth),
      transform var(--duration-fast) var(--ease-smooth),
      color var(--duration-base) var(--ease-smooth);
    white-space: nowrap;
  }

  .waypoint-nav:hover .waypoint-label {
    opacity: 1;
    transform: translateX(0);
  }

  .waypoint-link[data-active="true"] .waypoint-label {
    color: var(--color-signal);
  }

  @media (max-width: 768px) {
    .waypoint-nav {
      left: 26px;
    }
    .waypoint-label {
      display: none;
    }
  }
</style>

<script>
  import { digitRoll } from "../lib/reveal";

  function initWaypointNav() {
    const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-section]"));
    const dots = Array.from(document.querySelectorAll<HTMLElement>("[data-waypoint-dot]"));
    const links = Array.from(document.querySelectorAll<HTMLElement>("[data-waypoint-link]"));
    if (!sections.length) return;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let currentActive: string | null = null;

    function setActive(id: string) {
      if (id === currentActive) return;
      currentActive = id;

      dots.forEach((d) => d.toggleAttribute("data-active", d.dataset.waypointDot === id));
      links.forEach((l) => l.toggleAttribute("data-active", l.dataset.waypointLink === id));
      document.body.dataset.activeSection = id;

      // Dim every section except the one in focus — the tour has a spotlight,
      // not an evenly-lit document.
      sections.forEach((s) => {
        s.classList.toggle("is-dimmed", s.dataset.section !== id);
      });

      // Re-roll the active section's watermark digits every time it becomes
      // active — deliberately not gated to "first time only".
      const activeSection = sections.find((s) => s.dataset.section === id);
      const watermark = activeSection?.querySelector<HTMLElement>("[data-watermark]");
      if (watermark) {
        const final = watermark.dataset.watermark ?? watermark.textContent ?? "";
        if (reduceMotion) {
          watermark.textContent = final;
        } else {
          digitRoll(watermark, final);
        }
      }
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = (entry.target as HTMLElement).dataset.section;
            if (id) setActive(id);
          }
        });
      },
      { rootMargin: "-45% 0px -45% 0px", threshold: 0 }
    );
    sections.forEach((s) => observer.observe(s));

    // Reveal-on-scroll for anything marked .reveal, plus a real depth shift —
    // not just opacity, a slight scale-up from 0.97, so entering a section
    // reads as arriving somewhere rather than a slideshow fade.
    const revealTargets = Array.from(document.querySelectorAll(".reveal"));
    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            revealObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );
    revealTargets.forEach((t) => revealObserver.observe(t));
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initWaypointNav);
  } else {
    initWaypointNav();
  }
</script>
