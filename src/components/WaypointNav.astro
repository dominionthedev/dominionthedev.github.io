---
interface Waypoint {
  id: string;
  label: string;
}

interface Props {
  waypoints: Waypoint[];
}

const { waypoints } = Astro.props;
---

<nav class="waypoint-nav" aria-label="Page sections">
  <div class="waypoint-track">
    <div class="waypoint-fill" data-waypoint-fill></div>
  </div>
  <ol class="waypoint-list">
    {
      waypoints.map((wp) => (
        <li class="waypoint-item">
          <a href={`#${wp.id}`} class="waypoint-link" data-waypoint-link={wp.id}>
            <span class="waypoint-dot" data-waypoint-dot={wp.id} />
            <span class="waypoint-label">{wp.label}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .waypoint-nav {
    position: fixed;
    left: var(--space-8);
    top: 50%;
    transform: translateY(-50%);
    z-index: 100;
    display: flex;
    align-items: stretch;
  }

  .waypoint-track {
    position: absolute;
    left: 3px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: oklch(55% 0.02 295 / 0.25);
  }

  .waypoint-fill {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 0%;
    background: var(--color-phosphor);
    transition: height var(--duration-base) var(--ease-smooth);
  }

  .waypoint-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .waypoint-item {
    position: relative;
  }

  .waypoint-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-1) 0;
  }

  .waypoint-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--color-static);
    border: 1px solid var(--color-void);
    outline: 2px solid oklch(55% 0.02 295 / 0.3);
    outline-offset: 0;
    flex-shrink: 0;
    transition: background var(--duration-base) var(--ease-smooth),
      outline-color var(--duration-base) var(--ease-smooth);
  }

  .waypoint-dot[data-active="true"] {
    background: var(--color-phosphor);
    outline-color: var(--color-phosphor);
    box-shadow: var(--glow-phosphor);
  }

  .waypoint-label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-static);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--duration-fast) var(--ease-smooth),
      transform var(--duration-fast) var(--ease-smooth),
      color var(--duration-base) var(--ease-smooth);
    white-space: nowrap;
  }

  .waypoint-nav:hover .waypoint-label {
    opacity: 1;
    transform: translateX(0);
  }

  .waypoint-link[data-active="true"] .waypoint-label {
    color: var(--color-signal);
  }

  @media (max-width: 768px) {
    .waypoint-nav {
      left: var(--space-4);
    }
    .waypoint-label {
      display: none;
    }
  }
</style>

<script>
  function initWaypointNav() {
    const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-section]"));
    const dots = Array.from(document.querySelectorAll<HTMLElement>("[data-waypoint-dot]"));
    const links = Array.from(document.querySelectorAll<HTMLElement>("[data-waypoint-link]"));
    const fill = document.querySelector<HTMLElement>("[data-waypoint-fill]");
    if (!sections.length || !fill) return;

    function setActive(id: string) {
      dots.forEach((d) => d.toggleAttribute("data-active", d.dataset.waypointDot === id));
      links.forEach((l) => l.toggleAttribute("data-active", l.dataset.waypointLink === id));
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = (entry.target as HTMLElement).dataset.section;
            if (id) setActive(id);
          }
        });
      },
      { rootMargin: "-45% 0px -45% 0px", threshold: 0 }
    );
    sections.forEach((s) => observer.observe(s));

    function updateFill() {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? Math.min(1, scrollTop / docHeight) : 0;
      fill!.style.height = `${progress * 100}%`;
    }
    window.addEventListener("scroll", updateFill, { passive: true });
    updateFill();

    // Reveal-on-scroll for anything marked .reveal
    const revealTargets = Array.from(document.querySelectorAll(".reveal"));
    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            revealObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );
    revealTargets.forEach((t) => revealObserver.observe(t));
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initWaypointNav);
  } else {
    initWaypointNav();
  }
</script>
